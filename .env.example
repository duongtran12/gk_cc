MONGO_READ_URI=mongodb+srv://<read-user>:<password>@<cluster>/DB_23IT042?retryWrites=true&w=majority
MONGO_WRITE_URI=mongodb+srv://<write-user>:<password>@<cluster>/DB_23IT042?retryWrites=true&w=majority
# Dùng cùng write-user; tài khoản này cần readWrite riêng trên collection sessions.
MONGO_SESSION_URI=mongodb+srv://<write-user>:<password>@<cluster>/DB_23IT042?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-bytes
NODE_ENV=development
PORT=3000
# Chỉ cần khi DNS mặc định của Node không phân giải được mongodb+srv.
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
# Tùy chọn khi alias SRV của Atlas gặp lỗi SNI/TLS trên mạng cục bộ.
MONGO_CANONICAL_HOSTS=<host-00>:27017,<host-01>:27017,<host-02>:27017
MONGO_REPLICA_SET=<replica-set-from-atlas-txt-record>
